                },
                { "who": "haru", "face": "relaxed", "text": "……ふふ、なんか落ち着いた" }
              ]
            ]
          },
          {
            "type": "out",
            "text": "今日の写真、ネットに上げてもいい？『推しと会ってきた』って",
            "end": "sarashi",
            "reactions": [
              [
                { "who": "haru", "face": "blank", "text": "……え？" },
                { "who": "haru", "face": "sad", "text": "……ごめん。そういうの、むり" },
                { "who": "narr", "text": "──既読のまま、返事は来なかった。" }
              ]
            ]
          }
        ]
      },
      "after": [{ "who": "narr", "text": "──それから毎晩、少しずつメッセージをやり取りした。" }, { "cmd": "persona" }]
    }
