{
  "id": 4,
  "title": "第四章 リアル",
  "subtitle": "はじめまして、ひなの",
  "call": "kun",
  "defaults": { "ui": "adv", "model": "real", "bg": "cafe", "haruName": "ひなの", "contact": "ひなの" },
  "scenes": [
    {
      "id": "4-1",
      "set": { "bg": "station", "model": "none", "haruName": "？？？" },
      "moodHint": "before",
      "lines": [
        { "who": "narr", "text": "──日曜日、午後一時。駅前の時計台の下。" },
        { "who": "narr", "text": "約束の時間まで、あと五分。" },
        { "who": "narr", "if": { "minPop": 60 }, "text": "駅の広告に、見覚えのある赤い髪のVTuberが映っている。……登録者{subs}人の、天音ハル。" },
        { "cmd": "set", "model": "real", "face": "shy" },
        { "who": "narr", "text": "赤いパーカーの女の子が、おそるおそる近づいてくる。" },
        { "who": "haru", "face": "shy", "text": "あ、あの……{name}さん、ですか……？" }
      ],
      "choice": {
        "pool": [
          {
            "type": "good",
            "text": "思ってた通りの声だ。……はじめまして、だね",
            "reactions": [[{ "who": "haru", "face": "surprised", "text": "声で分かったの……？" }, { "who": "haru", "face": "shy", "text": "……はじめまして。えへへ、なんか変な感じ" }]]
          },
          {
            "type": "good",
            "text": "ハルちゃん……じゃなくて、なんて呼べばいい？",
            "reactions": [[{ "who": "haru", "face": "shy", "text": "あ……そ、そうだよね。外でハルはちょっと恥ずかしいもんね" }]]
          },
          { "type": "normal", "text": "はい、そうです", "reactions": [[{ "who": "haru", "face": "happy", "text": "よかったぁ……人違いだったらどうしようかと思った……" }]] },
          {
            "type": "good",
            "style": "mitsugi",
            "text": "（花束を渡す）登録者{subs}人、おめでとう",
            "echo": "これ、{subs}人おめでとう",
            "reactions": [
              [
                { "who": "haru", "face": "surprised", "text": "花束!? 駅前で!?" },
                {
                  "who": "haru",
                  "face": "shy",
                  "text": "……はずかしいけど、うれしい。ありがと",
                  "by": { "queen": { "face": "smug", "text": "……ふふ、わかってるじゃない。……あ、ありがと" } }
                }
              ]
            ]
          },
          {
            "type": "trap",
            "text": "緊張してる？ 大丈夫、僕は女の子と会うの慣れてるから",
            "reactions": [[{ "who": "haru", "face": "blank", "text": "……慣れてるんだ" }, { "who": "haru", "face": "sad", "text": "そ、そうなんだ……へぇ……" }]]
          },
          { "type": "bad", "text": "アバターと全然違いますね", "reactions": [[{ "who": "haru", "face": "sad", "text": "……だよね。地味でしょ、わたし" }]] },
          {
            "type": "gag",
            "delta": 4,
            "text": "本人確認のため「おつハル」って言ってください",
            "reactions": [
              [
                { "who": "haru", "face": "panic", "text": "こ、ここで!? 駅前で!?" },
                { "who": "haru", "face": "shy", "text": "……お、おつハル……（小声）" },
                {
                  "who": "haru",
                  "face": "happy",
                  "text": "って、まだ始まってもないのに終わらせないで！",
                  "by": { "geinin": { "face": "happy", "text": "会って三秒で終わらすな！ ……おつハル！ ……あ、言っちゃった！" } }
                }
              ]
            ]
          },
          {
            "type": "gag",
            "delta": 2,
            "text": "アバターより3Dですね",
            "reactions": [
              [
                { "who": "haru", "face": "surprised", "text": "そりゃそうだよ!? 現実だもん！" },
                { "who": "haru", "face": "relaxed", "text": "……ふふ、緊張してたの、ちょっとどっか行った" }
              ]
            ]
          },
          {
            "type": "out",
            "text": "（変装のつもりで、サングラス＋マスク＋全身タイツで来た）",
            "echo": false,
            "end": "shokushitsu",
            "reactions": [
              [
                { "who": "narr", "text": "──サングラス、マスク、そして全身タイツ。完璧な変装だ。" },
                { "who": "narr", "text": "周囲の視線が、痛い。" },
                { "who": "haru", "face": "blank", "text": "……" },
                { "who": "mob", "name": "警察官", "text": "すみません、ちょっとお話よろしいですか？" }
              ]
            ]
          }
        ]
      },
      "after": [
        { "who": "haru", "face": "shy", "text": "えっと……改めまして。春川ひなの、です" },
        { "cmd": "set", "haruName": "ひなの" },
        { "who": "haru", "face": "shy", "text": "……ハルの、中の人、です" },
        { "who": "haru", "face": "happy", "text": "今日はよろしくね、{name}くん！" }
      ]
    },
    {
      "id": "4-2",
      "lines": [
        { "who": "narr", "text": "──駅前の小さなカフェ。ひなのは、パフェを前に少しだけ黙りこんだ。" },
        { "who": "haru", "face": "sad", "text": "ほんとはね……ハルのわたしの方が、ちゃんとしてる気がして" },
        {
          "who": "haru",
          "face": "sad",
          "text": "リアルのわたし、地味でしょ？ 配信みたいに明るくできないし……",
          "by": {
            "queen": { "face": "sad", "text": "リアルのわたし、女王様でもなんでもないでしょ？ スパチャもないし……" },
            "geinin": { "face": "sad", "text": "リアルのわたし、ツッコミもできないし……配信みたいに、おもしろくないでしょ？" }
          }
        },
        { "who": "haru", "face": "panic", "if": { "flag": "slip" }, "text": "……あ、あと！ ずっと前の配信、切り忘れてたの……き、聞いてた……？" },
        { "who": "narr", "if": { "flag": "slip" }, "text": "（……聞いてた、とは言えない）" }
      ],
      "choice": {
        "pool": [
          {
            "type": "good",
            "text": "ハルちゃんもひなのさんも、両方好きだよ",
            "reactions": [
              [
                { "who": "haru", "face": "surprised", "text": "す、すき……!?" },
                { "who": "haru", "face": "panic", "text": "い、今のナシ……じゃなくて！ ナシにしなくていい……！" },
                { "who": "haru", "face": "shy", "text": "……ありがと" }
              ]
            ]
          },
          {
            "type": "good",
            "text": "今日いちばん笑ってたの、今のひなのさんだよ",
            "reactions": [[{ "who": "haru", "face": "surprised", "text": "え……" }, { "who": "haru", "face": "shy", "text": "……そっか。わたし、ちゃんと笑えてたんだ" }]]
          },
          { "type": "normal", "text": "そんなことないよ", "reactions": [[{ "who": "haru", "face": "relaxed", "text": "……ふふ、ありがと。優しいね" }]] },
          {
            "type": "good",
            "style": "mitsugi",
            "text": "ここは僕が払うよ。……あ、パフェもう一個どう？",
            "reactions": [[{ "who": "haru", "face": "surprised", "text": "二個目!? ……た、食べる" }, { "who": "haru", "face": "happy", "text": "……えへへ。リアルでも、甘やかされてる" }]]
          },
          {
            "type": "trap",
            "text": "ひなのさんもいいけど、やっぱりハルちゃんのほうが好きかな",
            "reactions": [[{ "who": "haru", "face": "sad", "text": "……そう、だよね。ハルのほうが、かわいいもんね" }]]
          },
          {
            "type": "bad",
            "text": "中の人ってやっぱいるんだ…",
            "reactions": [[{ "who": "haru", "face": "blank", "text": "……いるよ。ここに" }, { "who": "haru", "face": "sad", "text": "今それ言う……？" }]]
          },
          {
            "type": "gag",
            "text": "このパフェ、経費で落ちる？",
            "reactions": [
              [
                { "who": "haru", "face": "surprised", "text": "経費!? 取材だけど！ 一応取材だけど！" },
                { "who": "haru", "face": "happy", "text": "……落ちるかなぁ。ふふ、聞いてみる" }
              ]
            ]
          },
          {
            "type": "gag",
            "delta": 5,
            "text": "パフェのいちごを一つあげる（重大な決断）",
            "reactions": [[{ "who": "haru", "face": "surprised", "text": "いちごを!? パフェの主役を!?" }, { "who": "haru", "face": "shy", "text": "……そんな大事なもの、もらっていいの？" }]]
          },
          {
            "type": "out",
            "text": "サインください。転売用に3枚",
            "end": "dekin",
            "reactions": [
              [
                { "who": "haru", "face": "blank", "text": "……" },
                { "who": "haru", "face": "angry", "text": "帰る。" },
                { "who": "mob", "name": "店員", "text": "お客様、今後のご来店はご遠慮いただけますか" }
              ]
            ]
          }
        ]
      }
    },
    {
      "id": "4-3",
      "set": { "bg": "arcade" },
      "lines": [
        { "who": "narr", "text": "──カフェを出て、駅ビルのゲームセンターへ。" },
        { "who": "haru", "face": "surprised", "if": { "minPop": 50 }, "text": "……え。あれ、わたし……？" },
        { "who": "narr", "if": { "minPop": 50 }, "text": "クレーンゲームの景品は、デフォルメされた天音ハルのぬいぐるみだった。" },
        { "who": "haru", "face": "panic", "if": { "minPop": 50 }, "text": "グッズ化したのは知ってたけど……実物、はじめて見た……！" },
        { "who": "haru", "face": "happy", "if": { "maxPop": 49 }, "text": "あ！ 見て見て、あのぬいぐるみ、マロにそっくり！" },
        { "who": "narr", "if": { "maxPop": 49 }, "text": "クレーンゲームの景品は、ちょっと間の抜けた顔の猫のぬいぐるみだった。" },
        { "who": "haru", "face": "shy", "text": "……ほしい、かも" }
      ],
      "choice": {
        "pool": [
          {
            "type": "good",
            "text": "取ってみる。……見てて",
            "reactions": [
              [
                { "who": "narr", "text": "──三回目で、アームがぬいぐるみをつかんだ。" },
                { "who": "haru", "face": "happy", "motion": "jump", "text": "取れた!! すごい！ すごいすごい！" },
                { "who": "haru", "face": "shy", "text": "……大事にするね。ずっと" }
              ]
            ]
          },
          {
            "type": "good",
            "text": "一緒にやろう。ひなのさんがボタン、僕が横から見るから",
            "reactions": [
              [
                { "who": "haru", "face": "panic", "text": "わ、わたしがやるの!? 下手だよ!?" },
                { "who": "narr", "text": "──五回目。ぬいぐるみが、ころんと落ちた。" },
                { "who": "haru", "face": "happy", "text": "……取れた！ ふたりで取った！" }
              ]
            ]
          },
          {
            "type": "normal",
            "text": "取れたらいいね",
            "reactions": [[{ "who": "narr", "text": "──結局、取れなかった。" }, { "who": "haru", "face": "relaxed", "text": "ふふ、また今度だね" }]]
          },
          {
            "type": "good",
            "style": "mitsugi",
            "text": "（取れるまで一万円崩してくる）",
            "echo": "ちょっと両替してくる。取れるまでやる",
            "reactions": [
              [
                { "who": "narr", "text": "──二十三回目。ようやく、ぬいぐるみが落ちた。" },
                { "who": "haru", "face": "surprised", "text": "に、二十三回……!?" },
                {
                  "who": "haru",
                  "face": "happy",
                  "text": "……23って、なんか縁起いいね。ありがと",
                  "by": { "queen": { "face": "smug", "text": "……23回。ふふ、あの頃の同接と同じ。……ありがと、大事にする" } }
                }
              ]
            ]
          },
          {
            "type": "trap",
            "text": "本物のハルちゃんがここにいるんだから、ぬいぐるみいらないでしょ",
            "reactions": [[{ "who": "haru", "face": "blank", "text": "……" }, { "who": "haru", "face": "sad", "text": "そ、そういう意味じゃなくて……ほしかっただけなんだけど……" }]]
          },
          { "type": "bad", "text": "クレーンゲームってぼったくりだよ", "reactions": [[{ "who": "haru", "face": "sad", "text": "……そ、そうだよね。うん、やめとこ" }]] },
          {
            "type": "gag",
            "delta": 5,
            "text": "（ぬいぐるみに向かって）いつも配信見てます",
            "reactions": [
              [
                { "who": "haru", "face": "surprised", "text": "そっちに言うの!? 本人こっちだよ!?" },
                {
                  "who": "haru",
                  "face": "happy",
                  "text": "あはは！ もう、おなか痛い……！",
                  "by": { "geinin": { "face": "happy", "text": "ぬいぐるみに挨拶すな！ 本体こっち！ ……ふふっ、あかん、ツボった！" } }
                }
              ]
            ]
          },
          {
            "type": "out",
            "text": "（大声で）みなさーん！ この子、天音ハルの中の人でーす！",
            "end": "mibare",
            "reactions": [
              [
                { "who": "narr", "text": "──ゲームセンター中の視線が、こちらに集まった。" },
                { "who": "haru", "face": "blank", "text": "……" },
                { "who": "narr", "text": "──ひなのはフードを深くかぶって、走り去っていった。" }
              ]
            ]
          }
        ]
      },
      "after": [
        { "who": "narr", "text": "──気付けば、窓の外はオレンジ色に染まっていた。" },
        { "who": "haru", "face": "relaxed", "text": "……あ、もうこんな時間。今日はここまで、かな" },
        { "who": "haru", "face": "shy", "text": "取材、ありがと。……すっごく参考になった。たぶん" },
        { "who": "narr", "text": "──改札の向こうで、ひなのは小さく手を振った。" }
      ]
    },
    {
      "id": "4-4",
      "set": { "ui": "dm", "model": "none" },
      "lines": [
        { "who": "narr", "text": "──その夜。" },
        { "who": "haru", "face": "happy", "text": "今日はありがとう！ ちゃんと帰れた？" },
        { "who": "haru", "face": "shy", "text": "今日のこと思い出してたら、ぜんぜん眠れなくて" },
        { "who": "haru", "face": "shy", "text": "取材ってことにしてたけど……ほんとは、ただ会ってみたかっただけ、かも" },
        { "who": "haru", "face": "panic", "text": "な、なんでもない！ 今のなし！ 送信取り消し……できない……！" }
      ],
      "choice": {
        "pool": [
          {
            "type": "good",
            "text": "僕も楽しかった。また会いたいな",
            "reactions": [[{ "who": "haru", "face": "shy", "text": "……うん。わたしも" }, { "who": "haru", "face": "happy", "text": "じゃあ、次はわたしが行きたいとこ、考えとくね！" }]]
          },
          {
            "type": "good",
            "text": "取り消さなくていいよ。うれしかったから",
            "reactions": [[{ "who": "haru", "face": "panic", "text": "……っ" }, { "who": "haru", "face": "shy", "text": "スマホ、顔に落とした……。ちょっと待って、落ち着くから" }]]
          },
          { "type": "normal", "text": "おやすみ、また今度ね", "reactions": [[{ "who": "haru", "face": "relaxed", "text": "うん、おやすみ！ ……また今度、ね" }]] },
          {
            "type": "good",
            "style": "mitsugi",
            "text": "次はもっといいお店、予約しとくね。どこでも連れてくよ",
            "reactions": [[{ "who": "haru", "face": "surprised", "text": "え、ほんと!?" }, { "who": "haru", "face": "shy", "text": "……じゃあ、水族館、とか。行ってみたい" }]]
          },
          {
            "type": "trap",
            "text": "次いつ会える？ 明日は？ 明後日は？ 毎日でもいいよ",
            "reactions": [[{ "who": "haru", "face": "panic", "text": "ま、毎日はちょっと……" }, { "who": "haru", "face": "sad", "text": "……配信もあるし、ね" }]]
          },
          {
            "type": "bad",
            "text": "今日のこと、配信のネタにするの？",
            "reactions": [[{ "who": "haru", "face": "blank", "text": "……しないよ" }, { "who": "haru", "face": "sad", "text": "そういうふうに思ってたんだ……" }]]
          },
          {
            "type": "gag",
            "delta": 4,
            "text": "（取ったぬいぐるみと自撮りした写真を送る）",
            "echo": "（ぬいぐるみとの2ショットを送信）",
            "reactions": [[{ "who": "haru", "face": "surprised", "text": "なんでぬいぐるみと仲良くなってるの!?" }, { "who": "haru", "face": "happy", "text": "……ちょっと嫉妬した。ぬいぐるみに" }]]
          },
          {
            "type": "gag",
            "delta": 2,
            "text": "（ザリガニのスタンプを10個送る）",
            "echo": "🦞🦞🦞🦞🦞🦞🦞🦞🦞🦞",
            "reactions": [
              [
                {
                  "who": "haru",
                  "face": "surprised",
                  "text": "ザリガニ!? 夜中にザリガニ!?",
